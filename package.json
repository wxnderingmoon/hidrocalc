{
  "name": "hidrocalc",
  "version": "2.0.0",
  "description": "Calculadora de consumo de agua en el hogar con API en Express.js y base de datos PostgreSQL.",
  "scripts": {
    "start": "node server/app.js",
    "db:init": "psql -U postgres -f db/init.sql",
    "build": "bash build.sh",
    "test:navegadores": "node tests/pruebas-navegadores.js"
  },
  "author": "Paulina Gallardo Valadez",
  "license": "MIT",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "html-minifier-terser": "^7.2.0",
    "sharp": "^0.33.5",
    "terser": "^5.36.0",
    "puppeteer-core": "^23.10.0"
  },
  "main": "server/app.js",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  }
}
